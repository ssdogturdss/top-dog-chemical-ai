# =============================================================================
# Top Dog Chemical AI — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
# Local dev example: postgresql://postgres:password@localhost:5432/topdog
# Production example: postgresql://user:pass@your-db-host:5432/topdog
DATABASE_URL=postgresql://postgres:password@localhost:5432/topdog

# ---------------------------------------------------------------------------
# Session (required in production)
# ---------------------------------------------------------------------------
# Random secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# A default insecure value is used in development when this is unset.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Password for the field operator login screen.
# Defaults to "topdog" in development if unset — CHANGE THIS IN PRODUCTION.
ADMIN_PASSWORD=topdog

# ---------------------------------------------------------------------------
# OpenAI (required for AI Assistant feature)
# ---------------------------------------------------------------------------
# Standard OpenAI credentials.
# Inside Replit, AI_INTEGRATIONS_OPENAI_API_KEY / AI_INTEGRATIONS_OPENAI_BASE_URL
# are used instead (injected automatically by the Replit OpenAI integration).
OPENAI_API_KEY=sk-...
# Optional: set a custom base URL to use a compatible API (Azure OpenAI, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the API server listens on.
PORT=8080
# Node environment: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Port the Vite dev server runs on (defaults to 3000 when unset).
# FRONTEND_PORT=3000

# URL of the frontend app — added to the API server CORS allowlist.
# Set this in production so cross-origin requests are allowed.
# Example: FRONTEND_ORIGIN=https://topdog.example.com
FRONTEND_ORIGIN=http://localhost:3000

# Base path the frontend is mounted at (defaults to "/" when unset).
# Change only if you serve the frontend at a sub-path, e.g. /app.
# BASE_PATH=/

# In local dev the Vite dev server proxies /api to this URL automatically.
# Only needed if your API server runs on a non-default port.
# API_URL=http://localhost:8080
